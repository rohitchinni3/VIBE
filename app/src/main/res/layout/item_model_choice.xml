<?xml version="1.0" encoding="utf-8"?>
<!--
  item_model_choice.xml
  A single model row in dialog_choose_model.xml.
  Name and date are set programmatically; click listener dismisses the dialog and
  forwards to the confirmation step.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_mode_option_unselected"
    android:foreground="?attr/selectableItemBackground"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Folder icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📁"
        android:textSize="24sp"
        android:layout_marginEnd="12dp"/>

    <!-- Name + date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemModelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/itemModelDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- Chevron -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="#1A237E"
        android:textSize="22sp"
        android:textStyle="bold"/>

</LinearLayout>
